# Copy this file to .env and fill in your own values. Never commit .env.

# Which provider answers the LLM calls: anthropic (target) or openai.
LLM_PROVIDER=anthropic

# Keys: fill the one for the provider you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides. Empty = provider default:
#   anthropic: read=claude-haiku-5-5, evaluate=claude-sonnet-5-5
#   openai:    read=gpt-5-mini,       evaluate=gpt-5
MODEL_READ=
MODEL_EVALUATE=

# Optional: force one OpenAI reasoning effort for every role (low|medium|high).
# Empty = per-role defaults (read=low, evaluate=medium), reasoning models only.
OPENAI_REASONING_EFFORT=
